{
  "name": "certificate-print-client",
  "productName": "certificate-print-client",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:local": "dotenv -e .env.local -- electron-forge start",
    "start:prod": "dotenv -e .env.prod -- electron-forge start",
    "start:win": "npm run start:local",
    "start:prod:win": "npm run start:prod",
    "run:local:win": "cmd /c scripts\\run-local-win.cmd",
    "run:prod:win": "cmd /c scripts\\run-prod-win.cmd",
    "package": "electron-forge package",
    "package:win": "electron-forge package --platform=win32",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32",
    "make:prod:win": "dotenv -e .env.prod -- electron-forge make --platform=win32",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "elnasio",
    "email": "moriesdeo574@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "dotenv-cli": "^8.0.0",
    "electron": "40.8.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
